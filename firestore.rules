rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'App Admin' || getUserData().isAdmin == true);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    // Events
    match /events/{eventId} {
      allow read: if true; // Publicly readable
      allow create: if hasRole('Organizer') || isAdmin();
      allow update, delete: if isSignedIn() && (resource.data.organizerId == request.auth.uid || isAdmin());
    }
    
    // Applications
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        hasRole('Organizer') || 
        hasRole('App Admin') ||
        // Chairs can read applications for their own event/committee
        hasRole('Chair') 
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        hasRole('Organizer') || 
        isAdmin()
      );
    }
    
    // Messaging
    match /messages/{messageId} {
      allow read, create: if isSignedIn(); // Add more specific logic for group chats
    }
    
    // Markings
    match /markings/{markingId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.delegateId || 
        hasRole('Chair') || 
        hasRole('Organizer') || 
        isAdmin()
      );
      allow create, update: if hasRole('Chair') || hasRole('Organizer') || isAdmin();
    }
    
    // Complaints
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        hasRole('Chair') || 
        hasRole('Organizer') || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if hasRole('Organizer') || isAdmin();
    }
  }
}
